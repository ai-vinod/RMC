---
import { clinic } from '../data/clinic';
import { doctors } from '../data/doctors';
import { facts } from '../data/homeCopy';

const items = [
  { value: clinic.established, label: facts.establishedLabel },
  { value: doctors.length, label: facts.doctorsLabel },
  { value: facts.generations, label: facts.generationsLabel },
];
---

<div class="strip">
  <div class="facts">
    {
      items.map((item) => (
        <div>
          <b>{item.value}</b>
          <span>{item.label}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .strip {
    background: var(--ink);
  }
  .facts {
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .facts div {
    padding: 18px 14px;
    text-align: center;
    border-right: 1px solid var(--white-12);
  }
  .facts div:last-child {
    border-right: 0;
  }
  b {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-numeral);
    font-weight: 700;
    color: var(--orange-light);
    line-height: 1;
  }
  span {
    display: block;
    font-size: var(--text-kicker);
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--on-ink-muted);
    margin-top: 5px;
  }
</style>
