---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import SectionHead from './SectionHead.astro';
import { doctors } from '../data/doctors';
import { doctorsSection } from '../data/homeCopy';

// Initial for a doctor with no photo yet: first letter of the surname
const initial = (name: string) => name.trim().split(/\s+/).pop()!.charAt(0).toUpperCase();
---

<Section tone="cream">
  <SectionHead kicker={doctorsSection.kicker} heading={doctorsSection.heading} />
  <div class="docs">
    {
      doctors.map((doc) => (
        <div class="doc">
          {doc.photo ? (
            <Image class="av" src={doc.photo} alt={`Photo of ${doc.name}`} width={112} height={112} fit="cover" position="top" loading="lazy" />
          ) : (
            <div class="av ph" aria-hidden="true">
              {initial(doc.name)}
            </div>
          )}
          <div>
            <p class="fld">{doctorsSection.fieldLabels[doc.speciality]}</p>
            <h3>{doc.page ? <a href={doc.page}>{doc.name}</a> : doc.name}</h3>
            <p class="ql">{doc.qualifications}</p>
            <p class="rl">{doc.role}</p>
            {doc.note && <span class="yr">{doc.note}</span>}
          </div>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .docs {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  @media (min-width: 640px) {
    .docs {
      grid-template-columns: 1fr 1fr;
    }
  }
  .doc {
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    padding: 17px;
    display: flex;
    gap: 15px;
    align-items: flex-start;
  }
  .av {
    width: 62px;
    height: 62px;
    border-radius: 50%;
    flex: none;
    border: 3px solid var(--cream-deep);
    object-fit: cover;
    object-position: center top;
  }
  .ph {
    background: var(--gradient-orange);
    display: grid;
    place-items: center;
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 700;
    color: var(--on-orange);
  }
  .fld {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--orange-text);
    margin: 0 0 3px;
  }
  h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: 1.2;
  }
  h3 a {
    color: inherit;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  h3 a::after {
    content: '\2192';
    color: var(--orange-text);
    font-size: 16px;
    font-weight: 700;
  }
  .ql {
    margin: 3px 0 0;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-secondary);
  }
  .rl {
    margin: 4px 0 0;
    font-size: 13.5px;
    color: var(--ink-secondary);
  }
  .yr {
    display: inline-block;
    margin-top: 7px;
    background: var(--ink);
    color: var(--white);
    border-radius: 4px;
    padding: 3px 9px;
    font-size: 11.5px;
    font-weight: 700;
  }
</style>
