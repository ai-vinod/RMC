---
import { getCollection } from 'astro:content';
import Section from './Section.astro';
import SectionHead from './SectionHead.astro';
import { blogSection } from '../data/homeCopy';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

{
  /* No posts, no section: a heading over nothing, or placeholder cards, would be worse than leaving it out */
  posts.length > 0 && (
    <Section tone="white">
      <SectionHead kicker={blogSection.kicker} heading={blogSection.heading} />
      <div class="posts">
        {posts.map((post) => (
          <a class="post" href={`/blog/${post.id}/`}>
            <span class="strip" />
            <span class="in">
              <span class="tagx">{post.data.category}</span>
              <b>{post.data.title}</b>
              <span class="desc">{post.data.description}</span>
            </span>
          </a>
        ))}
      </div>
      <a class="all" href="/blog/">
        {blogSection.linkText}
      </a>
    </Section>
  )
}

<style>
  .posts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  /* Three columns whatever the count, so one or two posts keep a card's width instead of stretching */
  @media (min-width: 640px) {
    .posts {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .post {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--white);
    color: inherit;
    text-decoration: none;
    display: block;
  }
  .all {
    display: inline-block;
    margin-top: 18px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--orange-text);
    text-decoration: none;
  }
  .strip {
    display: block;
    height: 5px;
    background: var(--gradient-orange);
  }
  .in {
    display: block;
    padding: 15px var(--space-4);
  }
  .tagx {
    display: inline-block;
    background: var(--cream);
    color: var(--orange-text);
    border-radius: 4px;
    padding: 3px 9px;
    font-size: var(--text-kicker);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  b {
    display: block;
    font-family: var(--font-heading);
    font-size: 17px;
    font-weight: 700;
    margin-top: 9px;
    line-height: 1.25;
  }
  .desc {
    display: block;
    margin-top: 7px;
    font-size: 13.5px;
    color: var(--ink-secondary);
  }
</style>
