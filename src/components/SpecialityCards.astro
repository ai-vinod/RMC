---
import Section from './Section.astro';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { specialities } from '../data/homeCopy';
---

<Section tone="white">
  <SectionHead kicker={specialities.kicker} heading={specialities.heading} />
  <div class="cards">
    {
      specialities.cards.map((card) => (
        <div class="card">
          <div class="head">
            <Icon name={card.icon} strokeWidth={1.6} round />
            <h3>{card.title}</h3>
          </div>
          <div class="body">
            <p>{card.line}</p>
            {'note' in card && <span class="note">{card.note}</span>}
            <a class="go" href={card.href}>
              {card.linkText}
            </a>
          </div>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 640px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .card {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--white);
    position: relative;
  }
  .head {
    background: var(--gradient-orange);
    padding: var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .head :global(svg) {
    width: 28px;
    height: 28px;
    flex: none;
    color: var(--on-orange);
  }
  h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    color: var(--on-orange);
  }
  .body {
    padding: 15px var(--space-4);
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    flex: 1;
  }
  .note {
    margin-top: 11px;
    background: var(--cream);
    border-radius: var(--radius-sm);
    padding: 9px 11px;
    font-size: 12.5px;
    color: var(--orange-text);
    font-weight: 600;
    line-height: 1.4;
  }
  .go {
    margin-top: 13px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--orange-text);
    text-decoration: none;
  }
  /* The whole card is the tap target */
  .go::after {
    content: '';
    position: absolute;
    inset: 0;
  }
</style>
