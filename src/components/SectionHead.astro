---
interface Props {
  kicker?: string;
  heading: string;
  /** The page title uses h1, everything else h2 */
  level?: 'h1' | 'h2';
  /** Kicker colour on a charcoal band */
  dark?: boolean;
}

const { kicker, heading, level = 'h2', dark = false } = Astro.props;
const Heading = level;
---

{kicker && <p class:list={['kicker', { dark }]}>{kicker}</p>}
<Heading>{heading}</Heading>
<div class="rule"></div>

<style>
  .kicker {
    font-size: var(--text-kicker);
    font-weight: 700;
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--orange-text);
    margin: 0 0 7px;
  }
  .kicker.dark {
    color: var(--orange-light);
  }
  h1,
  h2 {
    font-family: var(--font-heading);
    font-size: var(--text-h2);
    font-weight: 700;
    margin: 0 0 4px;
    line-height: var(--leading-heading);
  }
  .rule {
    width: var(--rule-width);
    height: var(--rule-height);
    background: var(--gradient-orange);
    border-radius: 2px;
    margin: 0 0 22px;
  }
</style>
