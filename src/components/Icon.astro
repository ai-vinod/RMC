---
// Line and glyph icons from homepage-approved.html. Add new ones here, never inline in a component.
const icons = {
  phone: {
    fill: true,
    d: 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2z',
  },
} as const;

interface Props {
  name: keyof typeof icons;
}

const { name } = Astro.props;
const icon = icons[name];
---

<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill={icon.fill ? 'currentColor' : 'none'}>
  <path d={icon.d}></path>
</svg>
