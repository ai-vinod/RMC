---
// Icons from homepage-approved.html. Add new ones here, never inline in a component.
// fill: solid glyph. stroke: line icon.
const icons = {
  phone: {
    kind: 'fill',
    paths: ['M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2z'],
  },
  whatsapp: {
    kind: 'fill',
    paths: ['M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.2 1.2-1.7 1.2-.5.1-1 .1-1.7-.1a12 12 0 0 1-5.6-4.9c-.4-.6-1-1.5-1-2.8 0-1.3.7-2 .9-2.2.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2 0 .4-.1.6l-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2 1.3 2.3 1.4.2.1.4.1.6-.1l.7-.9c.2-.2.4-.2.6-.1l1.9.9c.2.1.4.2.4.3.1.2.1.6-.1 1.4z'],
  },
  clock: {
    kind: 'stroke',
    paths: ['M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 7v5l3.2 1.9'],
  },
  skin: {
    kind: 'stroke',
    paths: [
      'M15.5 3.2c-3.4 0-6 2.6-6 5.9 0 1.5.5 2.2.5 2.9 0 .8-1.7 1-1.7 2 0 .7.9.9.9 1.5 0 .5-.4.8-.4 1.3 0 1.1 1 1.8 2.3 1.8h1.4v2.2',
      'M12.3 8.9a.9.9 0 1 0 1.8 0 .9.9 0 1 0-1.8 0z',
      'M17.6 6.4a3 3 0 0 1 2.9 3',
    ],
  },
  bones: {
    kind: 'stroke',
    paths: [
      'M9.3 14.7 14.7 9.3',
      'M5.1 14.3a2.2 2.2 0 1 0 4.4 0 2.2 2.2 0 1 0-4.4 0z',
      'M7.5 16.7a2.2 2.2 0 1 0 4.4 0 2.2 2.2 0 1 0-4.4 0z',
      'M12.1 7.3a2.2 2.2 0 1 0 4.4 0 2.2 2.2 0 1 0-4.4 0z',
      'M14.5 9.7a2.2 2.2 0 1 0 4.4 0 2.2 2.2 0 1 0-4.4 0z',
    ],
  },
  tooth: {
    kind: 'stroke',
    paths: [
      'M12 4.2c-1.9 0-2.4 1-3.9 1S5.2 6.5 5.2 9c0 3.9 1.6 10 3.1 10 1.3 0 1-3.4 3.7-3.4s2.4 3.4 3.7 3.4c1.5 0 3.1-6.1 3.1-10 0-2.5-1.4-3.8-2.9-3.8s-2-1-3.9-1z',
    ],
  },
  play: {
    kind: 'fill',
    paths: ['M7 4l13 8-13 8z'],
  },
  chevronLeft: {
    kind: 'stroke',
    paths: ['M15 5l-7 7 7 7'],
  },
  chevronRight: {
    kind: 'stroke',
    paths: ['M9 5l7 7-7 7'],
  },
  calendar: {
    kind: 'stroke',
    paths: ['M6 5h12a2.5 2.5 0 0 1 2.5 2.5v10.5A2.5 2.5 0 0 1 18 20.5H6A2.5 2.5 0 0 1 3.5 18V7.5A2.5 2.5 0 0 1 6 5zM8 3v4M16 3v4M3.5 10h17'],
  },
} as const;

interface Props {
  name: keyof typeof icons;
  strokeWidth?: number;
  /** Round caps and joins, used by the speciality icons */
  round?: boolean;
}

const { name, strokeWidth = 1.9, round = false } = Astro.props;
const icon = icons[name];
---

<svg
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  fill={icon.kind === 'fill' ? 'currentColor' : 'none'}
  stroke={icon.kind === 'stroke' ? 'currentColor' : undefined}
  stroke-width={icon.kind === 'stroke' ? strokeWidth : undefined}
  stroke-linecap={icon.kind === 'stroke' && round ? 'round' : undefined}
  stroke-linejoin={icon.kind === 'stroke' && round ? 'round' : undefined}
>
  {icon.paths.map((d) => <path d={d} />)}
</svg>
