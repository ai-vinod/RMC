interface Props {
  name: keyof typeof icons;
  strokeWidth?: number;
  /** Round caps and joins, used by the speciality icons */
  round?: boolean;
  /** Draw a solid glyph as an outline instead (the footer phone) */
  outline?: boolean;
}

const { name, strokeWidth = 1.9, round = false, outline = false } = Astro.props;
const base = icons[name];
const icon = outline ? { ...base, kind: 'stroke' as const } : base;
---

<svg
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  fill={icon.kind === 'fill' ? 'currentColor' : 'none'}
  stroke={icon.kind === 'stroke' ? 'currentColor' : undefined}
  stroke-width={icon.kind === 'stroke' ? strokeWidth : undefined}
  stroke-linecap={icon.kind === 'stroke' && round ? 'round' : undefined}
  stroke-linejoin={icon.kind === 'stroke' && round ? 'round' : undefined}
>
  {icon.paths.map((d) => <path d={d} />)}
</svg>
