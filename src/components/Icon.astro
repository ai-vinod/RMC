---
// Icons from homepage-approved.html. Add new ones here, never inline in a component.
// fill: solid glyph. stroke: line icon.
const icons = {
  phone: {
    kind: 'fill',
    d: 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2z',
  },
  whatsapp: {
    kind: 'fill',
    d: 'M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.2 1.2-1.7 1.2-.5.1-1 .1-1.7-.1a12 12 0 0 1-5.6-4.9c-.4-.6-1-1.5-1-2.8 0-1.3.7-2 .9-2.2.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2 0 .4-.1.6l-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2 1.3 2.3 1.4.2.1.4.1.6-.1l.7-.9c.2-.2.4-.2.6-.1l1.9.9c.2.1.4.2.4.3.1.2.1.6-.1 1.4z',
  },
  clock: {
    kind: 'stroke',
    d: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 7v5l3.2 1.9',
  },
  calendar: {
    kind: 'stroke',
    d: 'M6 5h12a2.5 2.5 0 0 1 2.5 2.5v10.5A2.5 2.5 0 0 1 18 20.5H6A2.5 2.5 0 0 1 3.5 18V7.5A2.5 2.5 0 0 1 6 5zM8 3v4M16 3v4M3.5 10h17',
  },
} as const;

interface Props {
  name: keyof typeof icons;
}

const { name } = Astro.props;
const icon = icons[name];
---

<svg
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  fill={icon.kind === 'fill' ? 'currentColor' : 'none'}
  stroke={icon.kind === 'stroke' ? 'currentColor' : undefined}
  stroke-width={icon.kind === 'stroke' ? 1.9 : undefined}
>
  <path d={icon.d}></path>
</svg>
