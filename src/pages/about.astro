---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AboutIntro from '../components/AboutIntro.astro';
import DoctorCards from '../components/DoctorCards.astro';
import Schema from '../components/Schema.astro';
import { nav } from '../data/nav';
import { about } from '../data/aboutCopy';
import { breadcrumbNode, physicianNodes } from '../lib/schema';

// Set to false when the page's copy is approved: it makes the page indexable and adds it to the sitemap.
// Stays true until the doctor bios arrive.
const draft = true;

const home = nav.find((item) => item.href === '/')!;
const aboutNav = nav.find((item) => item.href === '/about/')!;
const nodes = [
  ...(await physicianNodes(Astro.site!)),
  breadcrumbNode(Astro.site!, [{ name: home.label, path: home.href }, { name: aboutNav.label }]),
];
---

<Base title={about.title} description={about.description} draft={draft}>
  <Schema slot="head" nodes={nodes} />
  <Breadcrumb trail={[{ label: home.label, href: home.href }, { label: aboutNav.label }]} />
  <AboutIntro />
  <DoctorCards large />
</Base>
