---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FactStrip from '../components/FactStrip.astro';
import SpecialityCards from '../components/SpecialityCards.astro';
import DoctorCards from '../components/DoctorCards.astro';
import WhyUs from '../components/WhyUs.astro';
import VideoRail from '../components/VideoRail.astro';
import ReviewRail from '../components/ReviewRail.astro';
import BlogTeasers from '../components/BlogTeasers.astro';
import FindUs from '../components/FindUs.astro';
import Schema from '../components/Schema.astro';
import { homeSeo } from '../data/homeCopy';
import { clinicNode, websiteNode } from '../lib/schema';

const nodes = [await clinicNode(Astro.site!), websiteNode(Astro.site!)];
---

<Base title={homeSeo.title} description={homeSeo.description}>
  <Schema slot="head" nodes={nodes} />
  <Hero />
  <FactStrip />
  <SpecialityCards />
  <DoctorCards />
  <WhyUs />
  <VideoRail />
  <ReviewRail />
  <BlogTeasers />
  <FindUs />
</Base>
